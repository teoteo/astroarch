[Unit]
Description=TigerVNC server for Wayland on port %i (shares the current local session)
After=graphical-session.target
PartOf=graphical-session.target
# The portal permission is granted at first login by
# astroarch-portal-permissions.service: until then w0vncserver may fail,
# so never give up retrying.
StartLimitIntervalSec=0

# The unit name gives w0vncserver the app ID org.astroarch.vnc (see
# configs/org.astroarch.vnc.desktop), so the portal permission covers only it.
# The instance is the port: astronaut uses @5900, astronaut-kiosk @5901.
[Service]
Type=simple
Environment=XDG_CONFIG_HOME=%h/.config
ExecStart=/usr/bin/w0vncserver -AlwaysShared -CompareFB 0 -rfbport %i -SecurityTypes None
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical-session.target
